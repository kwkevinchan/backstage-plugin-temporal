{
  "name": "@kwkevinchan/backstage-plugin-temporal-module-zigflow",
  "version": "0.0.0",
  "description": "Module of the unofficial Backstage Temporal plugin with the Definition tab for workflows written in the Serverless Workflow DSL and run by Zigflow",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "temporal",
    "workflow",
    "zigflow",
    "serverless-workflow"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-temporal/tree/main/plugins/temporal-module-zigflow",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal",
    "directory": "plugins/temporal-module-zigflow"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin-module",
    "pluginId": "temporal",
    "pluginPackage": "@kwkevinchan/backstage-plugin-temporal-frontend"
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "backstage:^",
    "@backstage/core-compat-api": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-catalog-react": "backstage:^",
    "@backstage/types": "backstage:^",
    "@backstage/ui": "backstage:^",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/lang-yaml": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@kwkevinchan/backstage-plugin-temporal-frontend": "workspace:^",
    "@lezer/highlight": "^1.0.0",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "@xyflow/react": "^12.12.0",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/frontend-test-utils": "backstage:^",
    "@backstage/plugin-permission-react": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "yaml": "^2.7.0"
  },
  "files": [
    "dist"
  ]
}
