{
  "name": "@kwkevinchan/backstage-plugin-temporal-backend",
  "version": "0.0.0",
  "description": "Unofficial Backstage backend plugin for Temporal workflows",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "temporal",
    "workflow"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-temporal/tree/main/plugins/temporal-backend",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal",
    "directory": "plugins/temporal-backend"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "temporal",
    "pluginPackages": [
      "@kwkevinchan/backstage-plugin-temporal",
      "@kwkevinchan/backstage-plugin-temporal-backend",
      "@kwkevinchan/backstage-plugin-temporal-common",
      "@kwkevinchan/backstage-plugin-temporal-node",
      "@kwkevinchan/backstage-plugin-temporal-react"
    ]
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "backstage:^",
    "@backstage/catalog-model": "backstage:^",
    "@backstage/config": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/plugin-catalog-node": "backstage:^",
    "@backstage/plugin-permission-common": "backstage:^",
    "@backstage/plugin-permission-node": "backstage:^",
    "@backstage/types": "backstage:^",
    "@kwkevinchan/backstage-plugin-temporal-common": "workspace:^",
    "@kwkevinchan/backstage-plugin-temporal-node": "workspace:^",
    "@kwkevinchan/temporal-payload-s3": "workspace:^",
    "@temporalio/client": "~1.24.0",
    "express": "^4.14.0",
    "express-promise-router": "^4.1.0"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "backstage:^",
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "backstage:^",
    "@backstage/plugin-catalog-backend": "backstage:^",
    "@backstage/plugin-permission-backend": "backstage:^",
    "@types/express": "^4.17.6",
    "@types/supertest": "^2.0.12",
    "supertest": "^6.2.4"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
