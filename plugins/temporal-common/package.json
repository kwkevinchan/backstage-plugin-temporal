{
  "name": "@kwkevinchan/backstage-plugin-temporal-common",
  "version": "0.0.0",
  "description": "Unofficial Backstage plugin for Temporal: types, permissions, API paths and the TemporalWorkflow entity, shared by the frontend and backend packages",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "temporal",
    "workflow"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-temporal/tree/main/plugins/temporal-common",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal",
    "directory": "plugins/temporal-common"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "common-library",
    "pluginId": "temporal",
    "pluginPackages": [
      "@kwkevinchan/backstage-plugin-temporal",
      "@kwkevinchan/backstage-plugin-temporal-backend",
      "@kwkevinchan/backstage-plugin-temporal-common"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "backstage:^",
    "@backstage/plugin-permission-common": "backstage:^",
    "@backstage/types": "backstage:^"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^"
  },
  "files": [
    "dist"
  ]
}
