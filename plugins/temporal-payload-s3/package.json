{
  "name": "@kwkevinchan/temporal-payload-s3",
  "version": "0.0.0",
  "description": "Temporal payload codec that stores large payloads in S3-compatible storage (claim check), for workers and the unofficial Backstage Temporal plugin",
  "license": "Apache-2.0",
  "keywords": [
    "temporal",
    "payload-codec",
    "claim-check",
    "s3"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-temporal/tree/main/plugins/temporal-payload-s3",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal",
    "directory": "plugins/temporal-payload-s3"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "node-library"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.350.0"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^"
  },
  "files": [
    "dist"
  ]
}
