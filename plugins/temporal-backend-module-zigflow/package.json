{
  "name": "@kwkevinchan/backstage-plugin-temporal-backend-module-zigflow",
  "version": "0.0.0",
  "description": "Module of the unofficial Backstage Temporal backend plugin that serves the Serverless Workflow (Zigflow) definitions of TemporalWorkflow entities",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "temporal",
    "workflow",
    "zigflow",
    "serverless-workflow"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-temporal/tree/main/plugins/temporal-backend-module-zigflow",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal",
    "directory": "plugins/temporal-backend-module-zigflow"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin-module",
