{
  "name": "@kwkevinchan/backstage-plugin-temporal-frontend",
  "version": "0.0.0",
  "description": "Unofficial Backstage frontend plugin for Temporal workflows: entity tab, Workflows page, workflow details and the operations that change workflows, with the extension points and blueprints for workflow actions, list actions and sections",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "temporal",
    "workflow"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-temporal/tree/main/plugins/temporal-frontend",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal",
    "directory": "plugins/temporal-frontend"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./common": "./src/common/index.ts",
    "./ui": "./src/ui.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "common": [
        "src/common/index.ts"
      ],
      "ui": [
        "src/ui.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "temporal",
    "pluginPackages": [
      "@kwkevinchan/backstage-plugin-temporal-backend",
      "@kwkevinchan/backstage-plugin-temporal-frontend"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "backstage:^",
    "@backstage/core-compat-api": "backstage:^",
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/filter-predicates": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-catalog-react": "backstage:^",
    "@backstage/plugin-permission-common": "backstage:^",
    "@backstage/plugin-permission-react": "backstage:^",
    "@backstage/types": "backstage:^",
    "@backstage/ui": "backstage:^",
    "@backstage/version-bridge": "backstage:^",
    "@dagrejs/dagre": "^1.1.4",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "@rjsf/core": "5.24.13",
    "@rjsf/utils": "5.24.13",
    "@rjsf/validator-ajv8": "5.24.13",
    "@xyflow/react": "^12.12.0",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/core-app-api": "backstage:^",
    "@backstage/dev-utils": "backstage:^",
    "@backstage/frontend-test-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@backstage/theme": "backstage:^",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
