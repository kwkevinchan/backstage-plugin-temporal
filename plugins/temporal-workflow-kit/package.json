{
  "name": "@kwkevinchan/temporal-workflow-kit",
  "version": "0.0.0",
  "description": "Helpers for Temporal workers shown by the unofficial Backstage Temporal plugin: loop markers for generate, check and revise loops, and LLM step records (OpenTelemetry GenAI) for AI agent workflows",
  "license": "Apache-2.0",
  "keywords": [
    "temporal",
    "workflow",
    "loop",
    "ai",
    "llm",
    "agent",
    "opentelemetry"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-temporal/tree/main/plugins/temporal-workflow-kit",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal",
    "directory": "plugins/temporal-workflow-kit"
  },
  "exports": {
    "./loop": "./src/loop/index.ts",
    "./llm": "./src/llm/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "loop": [
        "src/loop/index.ts"
      ],
      "llm": [
        "src/llm/index.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "node-library"
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "peerDependencies": {
    "@temporalio/workflow": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "@temporalio/workflow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@temporalio/activity": "~1.24.0",
    "@temporalio/client": "~1.24.0",
    "@temporalio/testing": "~1.24.0",
    "@temporalio/worker": "~1.24.0",
    "@temporalio/workflow": "~1.24.0"
  },
  "files": [
    "dist"
  ]
}
