{
  "name": "@kwkevinchan/backstage-plugin-temporal-react",
  "version": "0.0.0",
  "description": "Frontend extension points for the unofficial Backstage Temporal plugin",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "temporal",
    "workflow"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-temporal/tree/main/plugins/temporal-react",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-temporal",
    "directory": "plugins/temporal-react"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "web-library",
    "pluginId": "temporal",
    "pluginPackages": [
      "@kwkevinchan/backstage-plugin-temporal",
      "@kwkevinchan/backstage-plugin-temporal-backend",
      "@kwkevinchan/backstage-plugin-temporal-common",
      "@kwkevinchan/backstage-plugin-temporal-node",
      "@kwkevinchan/backstage-plugin-temporal-react"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-permission-common": "backstage:^",
    "@backstage/types": "backstage:^",
    "@backstage/version-bridge": "backstage:^",
    "@kwkevinchan/backstage-plugin-temporal-common": "workspace:^"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/frontend-test-utils": "backstage:^",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0"
  },
  "files": [
    "dist"
  ]
}
